{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../../",
    "lib": ["ESNext"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "types": ["node", "three", "vitest/importMeta", "vitest/globals"],
    "paths": {
      "@Showcases/Desktop/*": ["apps/showcases-desktop/src/*"],
      "@Showcases/Shared": ["packages/showcases-shared/src/index.ts"],
      "@Showcases/Shared/*": ["packages/showcases-shared/src/*"],
      "@Showcases/i18n": ["packages/showcases-i18n/src/index.ts"],
      "@Showcases/i18n/*": ["packages/showcases-i18n/src/*"],
      "@hellpig/anarchy-i18n": ["packages/anarchy-i18n/src/index.ts"],
      "@hellpig/anarchy-i18n/*": ["packages/anarchy-i18n/src/*"],
      "@hellpig/anarchy-shared": ["packages/anarchy-shared/src/index.ts"],
      "@hellpig/anarchy-shared/*": ["packages/anarchy-shared/src/*"],
      "@hellpig/anarchy-tracking": ["packages/anarchy-tracking/src/index.ts"],
      "@hellpig/anarchy-tracking/*": ["packages/anarchy-tracking/src/*"]
    }
  },
  "include": ["preload.ts", "types"],
  "exclude": ["dist", "node_modules"]
}
