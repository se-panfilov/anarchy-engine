{
  "extends": "../../tsconfig.bundler.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["apps/showcases-core/src/*"],
      "@Public/*": ["apps/showcases-core/public/*"],

      "@Anarchy/Engine": ["packages/anarchy-engine/src/index.ts"],
      "@Anarchy/Engine/*": ["packages/anarchy-engine/src/*"],
      "@Anarchy/I18N": ["packages/anarchy-i18n/src/index.ts"],
      "@Anarchy/I18N/*": ["packages/anarchy-i18n/src/*"],
      "@Anarchy/Shared": ["packages/anarchy-shared/src/index.ts"],
      "@Anarchy/Shared/*": ["packages/anarchy-shared/src/*"],
      "@Anarchy/Tracking": ["packages/anarchy-tracking/src/index.ts"],
      "@Anarchy/Tracking/*": ["packages/anarchy-tracking/src/*"],

      "@Showcases/E2E": ["apps/showcases-e2e/src/index.ts"],
      "@Showcases/E2E/*": ["apps/showcases-e2e/src/*"],
      "@Showcases/GUI": ["packages/showcases-gui/src/index.ts"],
      "@Showcases/GUI/*": ["packages/showcases-gui/src/*"],
      "@Showcases/I18N": ["packages/showcases-i18n/src/index.ts"],
      "@Showcases/I18N/*": ["packages/showcases-i18n/src/*"],
      "@Showcases/Menu": ["packages/showcases-menu/src/index.ts"],
      "@Showcases/Menu/*": ["packages/showcases-menu/src/*"],
      "@Showcases/Shared": ["packages/showcases-shared/src/index.ts"],
      "@Showcases/Shared/*": ["packages/showcases-shared/src/*"],

      "@hellpig/anarchy-engine": ["packages/anarchy-engine/src/index.ts"],
      "@hellpig/anarchy-engine/*": ["packages/anarchy-engine/src/*"],
      "@hellpig/anarchy-i18n": ["packages/anarchy-i18n/src/index.ts"],
      "@hellpig/anarchy-i18n/*": ["packages/anarchy-i18n/src/*"],
      "@hellpig/anarchy-shared": ["packages/anarchy-shared/src/index.ts"],
      "@hellpig/anarchy-shared/*": ["packages/anarchy-shared/src/*"],
      "@hellpig/anarchy-tracking": ["packages/anarchy-tracking/src/index.ts"],
      "@hellpig/anarchy-tracking/*": ["packages/anarchy-tracking/src/*"],

      "platform:api": ["apps/showcases-core/src/Platform/Drivers/web"],
      "showcases-gui/src/main": ["apps/showcases-core/types/showcases-gui-shim"],
      "showcases-menu/src/main": ["apps/showcases-core/types/showcases-menu-shim"],

      "date-fns/locale/types": ["node_modules/date-fns/locale/types.d.ts"],
      "three/examples/jsm/*": ["node_modules/@types/three/examples/jsm/*"],
      "three/src/*": ["node_modules/@types/three/src/*"],
      "@formatjs/intl/src/types": ["node_modules/@formatjs/intl/src/types.d.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "types", "dist-desktop", "dist-web", "dist-mobile", "dist"]
}
