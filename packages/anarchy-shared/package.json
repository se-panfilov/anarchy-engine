{
  "name": "@hellpig/anarchy-shared",
  "author": "S. Panfilov",
  "private": false,
  "version": "1.6.10",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github.com:se-panfilov/anarchy-engine.git",
    "directory": "packages/anarchy-shared"
  },
  "homepage": "https://github.com/se-panfilov/anarchy-engine/tree/main/packages/anarchy-shared#readme",
  "bugs": {
    "url": "https://github.com/se-panfilov/anarchy-engine/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.scss"
  ],
  "license": "MIT",
  "description": "Anarchy-shared – a library with shared utilities and scripts for Anarchy Engine.",
  "keywords": [
    "anarchy",
    "hellpig",
    "anarchy-engine",
    "anarchy-shared"
  ],
  "files": [
    "./legal/**",
    "CHANGELOG.md",
    "NOTICE.md",
    "LICENSE",
    "README.md",
    "dist/",
    "ScriptUtils/",
    "src/assets/"
  ],
  "exports": {
    "./Utils": {
      "types": "./dist/Utils/index.d.ts",
      "import": "./dist/Utils/index.es.js"
    },
    "./package.json": "./package.json",
    "./Constants": {
      "types": "./dist/Constants/index.d.ts",
      "import": "./dist/Constants/index.es.js"
    },
    "./Models": {
      "types": "./dist/Models/index.d.ts",
      "import": "./dist/Models/index.es.js"
    },
    "./Plugins": {
      "types": "./dist/Plugins/index.d.ts",
      "import": "./dist/Plugins/index.es.js"
    },
    "./assets/*": "./src/assets/*",
    "./ScriptUtils/*": "./ScriptUtils/*"
  },
  "bin": {
    "anarchy-shared-sanitize-assets": "./ScriptUtils/bin/anarchy-shared-cli.js",
    "anarchy-shared-copy-dir": "./ScriptUtils/bin/anarchy-shared-cli.js",
    "anarchy-shared-copy-files": "./ScriptUtils/bin/anarchy-shared-cli.js",
    "anarchy-shared-gen-versions": "./ScriptUtils/bin/anarchy-shared-cli.js",
    "anarchy-shared-inject-metadata": "./ScriptUtils/bin/anarchy-shared-cli.js",
    "anarchy-shared-mk-ico": "./ScriptUtils/bin/anarchy-shared-cli.js",
    "anarchy-shared-postprocess-screenshots": "./ScriptUtils/bin/anarchy-shared-cli.js",
    "anarchy-shared-rename-file": "./ScriptUtils/bin/anarchy-shared-cli.js",
    "anarchy-shared-check-minify": "./ScriptUtils/CheckMinify.sh"
  },
  "typesVersions": {
    "*": {
      "Utils": [
        "./dist/Utils/index.d.ts"
      ],
      "Constants": [
        "./dist/Constants/index.d.ts"
      ],
      "Models": [
        "./dist/Models/index.d.ts"
      ],
      "Plugins": [
        "./dist/Plugins/index.d.ts"
      ],
      "*": [
        "./dist/*/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "rimraf ./dist && vite build && npm run build:after",
    "build:after": "npm run check:dts-exports",
    "check:dts-exports": "node ../../scripts/release/check-dts-exports.mjs .",
    "generate:legal": "npm run generate:legal:3rd-party-licenses && npm run generate:legal:notice && npm run generate:legal:files && npm run generate:legal:sbom",
    "generate:legal:3rd-party-licenses": "npm run -w @hellpig/anarchy-legal generate:licenses -- --workspace packages/anarchy-shared --out ../../packages/anarchy-shared/legal/THIRD_PARTY_LICENSES.md",
    "generate:legal:files": "npm run -w @hellpig/anarchy-legal generate:files -- --workspace packages/anarchy-shared --out ../../packages/anarchy-shared",
    "generate:legal:notice": "npm run -w @hellpig/anarchy-legal generate:notice -- --audit --strict --workspace packages/anarchy-shared --source ../../packages/anarchy-shared/legal/THIRD_PARTY_LICENSES.md --out ../../packages/anarchy-shared/legal/NOTICE.md",
    "generate:legal:sbom": "npm sbom --sbom-format=cyclonedx --package-lock-only --omit=dev > ./compliance/sbom/sbom.cdx.json",
    "lint": "eslint ./src",
    "lint:fix": "npm run lint -- --fix",
    "pr:guard:ci": "npm run ts:check && npm run lint && npm run unit:coverage",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "ts:check": "tsc --noEmit",
    "ts:check:watch": "tsc --watch --noEmit",
    "unit": "vitest run",
    "unit:coverage": "vitest run --coverage",
    "unit:coverage:ui": "vitest --ui",
    "unit:watch": "vitest"
  },
  "dependencies": {
    "@gltf-transform/core": "4.4.1",
    "bowser": "2.14.1",
    "dotenv": "17.4.2",
    "dotenv-expand": "1000.0.0",
    "fast-glob": "3.3.3",
    "fs-extra": "11.4.0",
    "png-chunks-encode": "1.0.0",
    "png-chunks-extract": "1.0.0",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.3",
    "svgo": "4.0.2",
    "ts-json-schema-generator": "2.9.0"
  },
  "devDependencies": {
    "vite-plugin-static-copy": "4.1.1"
  }
}
