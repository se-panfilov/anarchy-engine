{
  "compilerOptions": {
    "baseUrl": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@Showcases/E2E": ["apps/showcases-e2e/src/index.ts"],
      "@Showcases/E2E/*": ["apps/showcases-e2e/src/*"],
      "@Showcases/GUI": ["packages/showcases-gui/src/index.ts"],
      "@Showcases/GUI/*": ["packages/showcases-gui/src/*"],
      "@Showcases/Menu": ["packages/showcases-menu/src/index.ts"],
      "@Showcases/Menu/*": ["packages/showcases-menu/src/*"],
      "@hellpig/anarchy-engine": ["packages/anarchy-engine/src/index.ts"],
      "@hellpig/anarchy-engine/*": ["packages/anarchy-engine/src/*"],
      "@hellpig/anarchy-i18n": ["packages/anarchy-i18n/src/index.ts"],
      "@hellpig/anarchy-i18n/*": ["packages/anarchy-i18n/src/*"],
      "@hellpig/anarchy-legal": ["packages/anarchy-legal/src/index.ts"],
      "@hellpig/anarchy-legal/*": ["packages/anarchy-legal/src/*"],
      "@hellpig/anarchy-shared": ["packages/anarchy-shared/src/index.ts"],
      "@hellpig/anarchy-shared/*": ["packages/anarchy-shared/src/*"],
      "@hellpig/anarchy-tracking": ["packages/anarchy-tracking/src/index.ts"],
      "@hellpig/anarchy-tracking/*": ["packages/anarchy-tracking/src/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "strictNullChecks": true,
    "target": "ESNext",
    "useDefineForClassFields": true
  }
}
